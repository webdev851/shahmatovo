footer.footer
	.footer__container.container 
		.footer__content 
			.footer__partners.partners
				.swiper.swiper-partners
					.swiper-wrapper.partners__list
						.swiper-slide.partners__item 
							a(href="https://culture.gov.ru/" aria-label="Минкульт" target="_blank").partners__link 
								+picture('partner-minkult', false, 'png')
						.swiper-slide.partners__item
							a(href="https://mk.mosreg.ru/" aria-label="МКМО" target="_blank").partners__link 
								+picture('partner-mkmo', false, 'png')
						.swiper-slide.partners__item
							a(href="https://zima.riamo.ru/" aria-label="Зима" target="_blank").partners__link.partners__link--fill
								+picture('partner-zima')
						.swiper-slide.partners__item
							a(href="https://www.gosuslugi.ru/" aria-label="Госуслуги" target="_blank").partners__link 
								+picture('partner-gosuslugi', false, 'png')
						.swiper-slide.partners__item
							a(href="http://club-wom.com/" aria-label="Мир музея" target="_blank").partners__link 
								+picture('partner-mirmuseya', false, 'png')
						.swiper-slide.partners__item
							a(href="https://grants.culture.ru/" aria-label="Культура.рф" target="_blank").partners__link.partners__link--fill
								+picture('partner-kultura')

			.footer__top
				.footer__left
					include parts/logo
					p.museum-name ГБУК&nbsp;МО «ГОСУДАРСТВЕННЫЙ МЕМОРИАЛЬНЫЙ МУЗЕЙ-ЗАПОВЕДНИК Д.И.&nbsp;МЕНДЕЛЕЕВА И&nbsp;А.А.&nbsp;БЛОКА»
					a(href="#" aria-label="Кнопка наверх").btn.btn-up Наверх
				nav.nav.footer__nav
					ul.nav__list 
						li.nav__title 
							h5 Музей
						li.nav__item
							a.nav__link.link(href=`${sitePath}shahmatovo.html`) Шахматово
						li.nav__item
							a.nav__link.link(href=`${sitePath}boblovo.html`) Боблово
						li.nav__item
							a.nav__link.link(href=`${sitePath}tarakanovo.html`) Тараканово
						li.nav__item
							a.nav__link.link(href=`${sitePath}history.html`) История музея
						li.nav__item
							a.nav__link.link(href=`${sitePath}park.html`) Заповедник
					ul.nav__list 
						li.nav__title 
							h5 Посетителям
						li.nav__item
							a.nav__link.link(href=`${sitePath}tickets.html`) Стоимость билетов
						li.nav__item
							a.nav__link.link(href=`${sitePath}pushkin-card.html`) Пушкинская карта
						li.nav__item
							a.nav__link.link(href=`${sitePath}gallery.html`) Галерея
						li.nav__item
							a.nav__link.link(href=`${sitePath}events.html`) Афиша
					ul.nav__list 
						li.nav__title 
							h5 Информация
						li.nav__item
							a.nav__link.link(href=`${sitePath}documents.html`) Документы
						li.nav__item
							a.nav__link.link(href=`${sitePath}news.html`) Новости
						li.nav__item
							a.nav__link.link(href=`${sitePath}funds.html`) Фонды
						li.nav__item
							a.nav__link.link(href=`${sitePath}contacts.html`) Контакты
			.footer__bottom 	
				.footer__copy 
					span#copy-year
					span  © ГОСУДАРСТВЕННЫЙ МЕМОРИАЛЬНЫЙ МУЗЕЙ-ЗАПОВЕДНИК Д.И. МЕНДЕЛЕЕВА И А.А. БЛОКА.
				.footer__social.social
					ul.social__list
						li.social__item
							img(src=`${sitePath}img/vector-icons/icon-vk.svg`, alt="")
							a.social__link.link(href="https://vk.com/muzey.bloka" target="_blank") ВКонтакте
						li.social__item
							img(src=`${sitePath}img/vector-icons/icon-ok.svg`, alt="")
							a.social__link.link(href="https://ok.ru/group/58176695500828" target="_blank") Одноклассники
						li.social__item
							img(src=`${sitePath}img/vector-icons/icon-tg.svg`, alt="")
							a.social__link.link(href="https://t.me/blok_museum" target="_blank") Телеграм
						li.social__item
							img(src=`${sitePath}img/vector-icons/icon-yt.svg`, alt="")
							a.social__link.link(href="https://www.youtube.com/channel/UCOdk1EbUILrCNqcehUSRy6g/" target="_blank") Youtube
